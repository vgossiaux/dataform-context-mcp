            "query": "\n\nSELECT\n  e.session_id,\n  ANY_VALUE(e.customer_id) AS customer_id,\n  MIN(e.event_ts) AS session_start,\n  SUM(e.amount) AS amount,\n  SUM(item.qty) AS item_qty\nFROM `fixture-project.staging.stg_events` AS e, UNNEST(e.items) AS item\nWHERE TRUE\n\nGROUP BY e.session_id\n",
            "disabled": false,
            "fileName": "definitions/transforms/02_intermediate/int_sessions.sqlx",
            "actionDescriptor": {
                "description": "Sessionized events with unnested item quantities"
