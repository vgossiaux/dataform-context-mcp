    "operations": [
        {
            "target": {
                "schema": "intermediate",
                "name": "ops_merge_snapshot",
                "database": "fixture-project"
            },
            "queries": [
                "\n\nMERGE `fixture-project.intermediate.ops_merge_snapshot` AS t\nUSING (\n  SELECT event_id, amount FROM `fixture-project.staging.stg_events`\n) AS s\nON t.event_id = s.event_id\nWHEN MATCHED THEN UPDATE SET amount = s.amount\nWHEN NOT MATCHED THEN INSERT (event_id, amount) VALUES (s.event_id, s.amount)\n"
            ],
